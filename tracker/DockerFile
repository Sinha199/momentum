# Multi-stage build: the Maven + JDK stage only compiles; the final image is JRE + one jar.
FROM docker.io/library/maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
# Dependencies first, so editing src/ doesn't re-download them.
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B package -DskipTests

FROM docker.io/library/eclipse-temurin:17-jre
WORKDIR /app
RUN useradd --system --uid 1001 app
USER app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]